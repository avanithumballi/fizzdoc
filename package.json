{
  "name": "fizzdoc",
  "version": "0.1.0",
  "private": true,
  "description": "Private PDF tools that run entirely in your browser. No uploads.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "tsc --noEmit && vitest run"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@neslinesli93/qpdf-wasm": "0.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/node": "^22.20.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
